  "description": "Bridge between ioBroker states and MQTT with JSON export and Remote Sync",
  "author": "proxy <proxy@ich.ms>",
  "license": "MIT",
  "homepage": "https://github.com/Proxyyy87/ioBroker.mqtt-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proxyyy87/ioBroker.mqtt-plus.git"
  },
