{
  "i18n": true,
  "type": "tabs",
  "items": {
    "main": {
      "type": "panel",
      "label": "Settings & routes",
      "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTMgMTNIMXYtMmgydjJ6bTA-MmgydjJIN1YzHptMTQgMTlIMXYtMmgydjJ6bTQtMmgydjJIN1YxN3ptNCAwaC0ydjJoMnYtMnoiLz48L3N2Zz4=",
      "items": {
        "targetBasePath": {
          "type": "text",
          "label": "MQTT target path (prefix)",
          "default": "mqtt.0.",
          "sm": 6,
          "help": "Must end with a dot, e.g. mqtt.0.",
          "xs": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "updateIntervalSec": {
          "type": "number",
          "label": "Update interval (s)",
          "default": 30,
          "sm": 3,
          "xs": 12,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "logTransfers": {
          "type": "checkbox",
          "label": "Log transfers",
          "default": true,
          "sm": 3,
          "xs": 12,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "forceSyncIntervalMin": {
          "type": "number",
          "label": "Force sync interval (min, 0 = off)",
          "default": 5,
          "sm": 3,
          "help": "Compares source and target and only writes deviations - mappings in sync mode \"Force\" are always rewritten.",
          "xs": 12,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "staleAfterMin": {
          "type": "number",
          "label": "Staleness limit (min, 0 = off)",
          "default": 1440,
          "min": 0,
          "sm": 3,
          "help": "Sources whose last update is older (or with quality q≠0) are not mirrored on start, update interval and force sync - so an inactive device does not become \"fresh\" again on the target side. Real change events always pass. Default: 1440 (24 h).",
          "xs": 12,
          "md": 3,
          "lg": 3,
          "xl": 3
        },
        "mappings": {
          "type": "accordion",
          "label": "Mappings",
          "titleAttr": "mqttName",
          "clone": true,
          "newLine": true,
          "sm": 12,
          "items": [
            {
              "type": "objectId",
              "attr": "id",
              "label": "Source ID (ioBroker)",
              "xs": 12,
              "sm": 12,
              "md": 6,
              "lg": 4,
              "xl": 4
            },
            {
              "type": "text",
              "attr": "mqttName",
              "label": "Path suffix (e.g. home/kitchen/light)",
              "xs": 12,
              "sm": 12,
              "md": 6,
              "lg": 3,
              "xl": 3
            },
            {
              "type": "select",
              "attr": "dir",
              "label": "Direction",
              "options": [
                {
                  "value": "out",
                  "label": "IOB -> MQTT"
                },
                {
                  "value": "in",
                  "label": "MQTT -> IOB"
                },
                {
                  "value": "both",
                  "label": "Both"
                }
              ],
              "default": "out",
              "xs": 12,
              "sm": 6,
              "md": 4,
              "lg": 2,
              "xl": 2
            },
            {
              "type": "select",
              "attr": "topicMode",
              "label": "MQTT topic mode",
              "options": [
                {
                  "value": "single",
                  "label": "Single (one topic)"
                },
                {
                  "value": "dual",
                  "label": "Dual (command on /set)"
                }
              ],
              "default": "single",
              "xs": 12,
              "sm": 6,
              "md": 4,
              "lg": 2,
              "xl": 2,
              "help": "Dual: commands on <topic>/set"
            },
            {
              "type": "text",
              "attr": "commandSuffix",
              "label": "Command suffix",
              "default": "/set",
              "xs": 12,
              "sm": 6,
              "md": 4,
              "lg": 1,
              "xl": 1,
              "hidden": "data.topicMode !== 'dual'"
            },
            {
              "type": "select",
              "attr": "type",
              "label": "Type",
              "options": [
                {
                  "value": "auto",
                  "label": "Auto"
                },
                {
                  "value": "round",
                  "label": "Round"
                },
                {
                  "value": "boolToNum",
                  "label": "Bool->Num"
                },
                {
                  "value": "numToBool",
                  "label": "Num->Bool"
                }
              ],
              "default": "auto",
              "newLine": true,
              "xs": 12,
              "sm": 6,
              "md": 3,
              "lg": 2,
              "xl": 2
            },
            {
              "type": "number",
              "attr": "decimals",
              "label": "Decimals",
              "default": 2,
              "xs": 12,
              "sm": 6,
              "md": 3,
              "lg": 1,
              "xl": 1,
              "hidden": "data.type !== 'round'"
            },
            {
              "type": "text",
              "attr": "unit",
              "label": "Unit",
              "xs": 12,
              "sm": 6,
              "md": 2,
              "lg": 1,
              "xl": 1
            },
            {
              "type": "select",
              "attr": "ackFilter",
              "label": "Ack filter",
              "options": [
                {
                  "value": "confirmed",
                  "label": "Confirmed only (ack=true)"
                },
                {
                  "value": "any",
                  "label": "Also unconfirmed (userdata/alias)"
                }
              ],
              "default": "confirmed",
              "xs": 12,
              "sm": 6,
              "md": 4,
              "lg": 3,
              "xl": 3,
              "help": "\"Also unconfirmed\" for 0_userdata/alias"
            },
            {
              "type": "number",
              "attr": "staleAfterMin",
              "label": "Staleness (min)",
              "min": 0,
              "xs": 12,
              "sm": 6,
              "md": 3,
              "lg": 2,
              "xl": 2,
              "help": "empty = global, 0 = off",
              "hidden": "data.syncMode === 'force'"
            },
            {
              "type": "select",
              "attr": "syncMode",
              "label": "Sync mode",
              "default": "standard",
              "xs": 12,
              "sm": 6,
              "md": 4,
              "lg": 3,
              "xl": 3,
              "options": [
                {
                  "value": "standard",
                  "label": "Standard (changes only)"
                },
                {
                  "value": "refresh",
                  "label": "Pass every update"
                },
                {
                  "value": "force",
                  "label": "Force (as before 1.6.0)"
                }
              ],
              "help": "See documentation: sync mode"
            }
          ],
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "webTab": {
      "type": "panel",
      "label": "Web dashboard",
      "icon": "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZD0iTTE0IDJINkM0Ljg5IDIgNCAyLjg5IDQgNHYxNmMwIDEuMTEuODkgMiAyIDJoMTJjMS4xMSAwIDItLjg5IDItMlY4bC02LTZ6bS0xIDlIN3YtMmg2djJ6bTMgN0g3di0yaDEwdjJ6bTAtNEg3di0yaDEwdjJ6Ii8+PC9zdmc+",
      "items": {
        "webInfo": {
          "type": "staticText",
          "text": "The adapter provides a web interface for backup/restore and status. Use the link in the instance overview.",
          "sm": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "port": {
          "type": "number",
          "label": "Web server port",
          "default": 8095,
          "sm": 4,
          "xs": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "bind": {
          "type": "select",
          "label": "Bind interface",
          "default": "0.0.0.0",
          "sm": 4,
          "options": [
            {
              "value": "0.0.0.0",
              "label": "All interfaces (reachable from LAN)"
            },
            {
              "value": "127.0.0.1",
              "label": "Local only (127.0.0.1)"
            }
          ],
          "xs": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "dashboardUser": {
          "type": "text",
          "label": "Dashboard user name",
          "default": "admin",
          "sm": 4,
          "xs": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "dashboardPassword": {
          "type": "password",
          "label": "Dashboard password",
          "sm": 4,
          "help": "Leave empty = no access protection (not recommended). Requested via HTTP basic auth.",
          "xs": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "dashboardTlsCert": {
          "type": "text",
          "label": "TLS certificate (PEM, optional)",
          "sm": 6,
          "help": "Set together with the TLS key: the dashboard runs via HTTPS instead of HTTP, credentials are transmitted encrypted.",
          "minRows": 6,
          "maxRows": 12,
          "xs": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "dashboardTlsKey": {
          "type": "text",
          "label": "TLS key (PEM, optional)",
          "sm": 6,
          "help": "Private key for the certificate above. Leave empty = HTTP (unencrypted). Stored encrypted (encryptedNative).",
          "minRows": 6,
          "maxRows": 12,
          "xs": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    },
    "syncTab": {
      "type": "panel",
      "label": "Remote sync",
      "icon": "data:image/svg+xml;base64,",
      "items": {
        "syncUrl": {
          "type": "text",
          "label": "Webhook URL",
          "sm": 12,
          "help": "Complete URL including API key parameter, e.g. https://.../sync?api-key=123",
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "syncIntervalMin": {
          "type": "number",
          "label": "Interval (min)",
          "default": 60,
          "sm": 6,
          "xs": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "remoteSyncSkipStale": {
          "type": "checkbox",
          "label": "Skip inactive sources",
          "default": false,
          "sm": 6,
          "help": "Values that are considered inactive according to the staleness limit/quality are not sent to the webhook.",
          "xs": 12,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "syncCaCert": {
          "type": "text",
          "label": "Trusted certificate / CA (PEM, optional)",
          "sm": 12,
          "help": "Only required for a self-signed/internal certificate of the sync target. Leave empty for a public certificate (the default system trust store is used).",
          "minRows": 6,
          "maxRows": 12,
          "xs": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "checkSync": {
          "type": "sendTo",
          "command": "checkSync",
          "label": "Check connection",
          "sm": 4,
          "variant": "contained",
          "xs": 12,
          "md": 4,
          "lg": 4,
          "xl": 4
        },
        "lastSyncStatus": {
          "type": "state",
          "oid": "info.lastSyncStatus",
          "label": "Last status / error code",
          "readOnly": true,
          "sm": 8,
          "xs": 12,
          "md": 8,
          "lg": 8,
          "xl": 8
        }
      }
    }
  }
}
